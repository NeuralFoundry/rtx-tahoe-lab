+/* Standalone SPIR-V to NVIDIA graphics code probe. No GPU device is opened. */
+#include "nak.h"
+#include "nak_private.h"
+#include "nv_device_info.h"
+#include "compiler/glsl_types.h"
+#include "compiler/spirv/nir_spirv.h"
+#include "nir.h"
+#include "util/ralloc.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "flags_abi233.h"
+
+static bool
+write_file(const char *path, const void *data, size_t bytes)
+{
+   FILE *f = fopen(path, "wbx");
+   if (!f)
+      return false;
+   bool ok = fwrite(data, 1, bytes, f) == bytes;
+   return fclose(f) == 0 && ok;
+}
+
+int
+main(int argc, char **argv)
+{
+   if (argc == 2 && !strcmp(argv[1], "--check-flags"))
+      return check_flags_abi();
+   if (argc != 6 || (strcmp(argv[1], "vertex") && strcmp(argv[1], "fragment"))) {
+      fprintf(stderr, "usage: nak_standalone vertex|fragment input.spv code.bin header.bin assembly.txt\n");
+      return 2;
+   }
+   mesa_shader_stage stage = !strcmp(argv[1], "vertex") ? MESA_SHADER_VERTEX : MESA_SHADER_FRAGMENT;
+   FILE *input = fopen(argv[2], "rb");
+   if (!input)
+      return 2;
+   if (fseek(input, 0, SEEK_END)) {
+      fclose(input);
+      return 2;
+   }
+   long size = ftell(input);
+   if (size < 20 || size > 4 * 1024 * 1024 || (size & 3) || fseek(input, 0, SEEK_SET)) {
+      fclose(input);
+      return 2;
+   }
+   uint32_t *words = malloc((size_t)size);
+   if (!words) {
+      fclose(input);
+      return 2;
+   }
+   bool read_ok = fread(words, 1, (size_t)size, input) == (size_t)size;
+   read_ok = fclose(input) == 0 && read_ok;
+   if (!read_ok || words[0] != 0x07230203) {
+      free(words);
+      return 2;
+   }
+
+   /* Offline GA106 compiler profile; these are not live device observations. */
+   const struct nv_device_info device = {
+      .type = NV_DEVICE_TYPE_DIS,
+      .sm = 86,
+      .max_warps_per_mp = 48,
+      .cls_eng3d = 0xc797,
+   };
+   fprintf(stderr, "standalone: initialize compiler\n");
+   glsl_type_singleton_init_or_ref();
+   struct nak_compiler *compiler = nak_compiler_create(&device);
+   const struct spirv_to_nir_options options = {
+      .environment = NIR_SPIRV_VULKAN,
+      .ignore_replacement = true,
+      .skip_os_break_in_debug_build = true,
+   };
+   fprintf(stderr, "standalone: SPIR-V to NIR\n");
+   nir_shader *nir = spirv_to_nir(words, (size_t)size / 4, NULL, stage, "main",
+                                &options, nak_nir_options(compiler));
+   free(words);
+   int rc = 1;
+   struct nak_shader_bin *binary = NULL;
+   if (!nir)
+      goto finish;
+   fprintf(stderr, "standalone: preprocess NIR\n");
+   nak_preprocess_nir(nir, compiler);
+   struct nak_fs_key fs_key = {0};
+   fprintf(stderr, "standalone: compile NAK\n");
+   binary = nak_compile_shader(nir, true, compiler, 0,
+                               stage == MESA_SHADER_FRAGMENT ? &fs_key : NULL, false);
+   fprintf(stderr, "standalone: inspect binary\n");
+   if (!binary || !binary->code || !binary->asm_str || binary->info.sm != 86 ||
+       binary->info.stage != stage || !binary->code_size || binary->code_size > 4 * 1024 * 1024)
+      goto finish;
+   if (!write_file(argv[3], binary->code, binary->code_size) ||
+       !write_file(argv[4], binary->info.hdr, sizeof(binary->info.hdr)) ||
+       !write_file(argv[5], binary->asm_str, strlen(binary->asm_str)))
+      goto finish;
+   printf("{\"passed\":true,\"stage\":\"%s\",\"sm\":86,\"code_bytes\":%u,"
+          "\"header_bytes\":%zu,\"gprs\":%u,\"instructions\":%u,"
+          "\"scratch_bytes\":%u,\"gpu_executed\":false}\n",
+          argv[1], binary->code_size, sizeof(binary->info.hdr), binary->info.num_gprs,
+          binary->info.num_instrs, binary->info.slm_size);
+   rc = 0;
+finish:
+   if (binary)
+      nak_shader_bin_destroy(binary);
+   if (nir)
+      ralloc_free(nir);
+   nak_compiler_destroy(compiler);
+   glsl_type_singleton_decref();
+   return rc;
+}
