+use nak_bindings::*;
+use std::ffi::c_void;
+#[no_mangle]
+pub extern "C" fn nak_validate_flag_words233(kind: u32, ptr: *const c_void, expected: u32) -> bool {
+ if ptr.is_null() { return false; }
+ match kind {
+  0 => {
+   if std::mem::size_of::<nak_nir_tex_flags>() != 4 { return false; }
+   let f = unsafe { &*(ptr.cast::<nak_nir_tex_flags>()) };
+   f.ref_type() == ((expected >> 0) & 3)
+   && f.lod_mode() == ((expected >> 2) & 7)
+   && f.offset_mode() == ((expected >> 5) & 3)
+   && f.has_z_cmpr() == ((expected >> 7) & 1)
+   && f.is_sparse() == ((expected >> 8) & 1)
+   && f.nodep() == ((expected >> 9) & 1)
+   && f.scalar() == ((expected >> 10) & 1)
+   && f.pad() == ((expected >> 11) & 2097151)
+  },
+  1 => {
+   if std::mem::size_of::<nak_nir_attr_io_flags>() != 4 { return false; }
+   let f = unsafe { &*(ptr.cast::<nak_nir_attr_io_flags>()) };
+   f.output() == ((expected >> 0) & 1)
+   && f.patch() == ((expected >> 1) & 1)
+   && f.phys() == ((expected >> 2) & 1)
+   && f.pad() == ((expected >> 3) & 536870911)
+  },
+  2 => {
+   if std::mem::size_of::<nak_nir_suclamp_flags>() != 4 { return false; }
+   let f = unsafe { &*(ptr.cast::<nak_nir_suclamp_flags>()) };
+   f.mode() == ((expected >> 0) & 3)
+   && f.round() == ((expected >> 2) & 7)
+   && f.is_s32() == ((expected >> 5) & 1)
+   && f.is_2d() == ((expected >> 6) & 1)
+   && f.pad() == ((expected >> 7) & 33554431)
+  },
+  3 => {
+   if std::mem::size_of::<nak_nir_imadsp_flags>() != 4 { return false; }
+   let f = unsafe { &*(ptr.cast::<nak_nir_imadsp_flags>()) };
+   f.src0() == ((expected >> 0) & 7)
+   && f.src1() == ((expected >> 3) & 7)
+   && f.src2() == ((expected >> 6) & 7)
+   && f.params_from_src1() == ((expected >> 9) & 1)
+   && f.pad() == ((expected >> 10) & 4194303)
+  },
+  4 => {
+   if std::mem::size_of::<nak_nir_isbe_flags>() != 4 { return false; }
+   let f = unsafe { &*(ptr.cast::<nak_nir_isbe_flags>()) };
+   f.access() == ((expected >> 0) & 3)
+   && f.output() == ((expected >> 2) & 1)
+   && f.skew() == ((expected >> 3) & 1)
+   && f.per_primitive() == ((expected >> 4) & 1)
+   && f.pad() == ((expected >> 5) & 134217727)
+  },
+  5 => {
+   if std::mem::size_of::<nak_nir_ipa_flags>() != 4 { return false; }
+   let f = unsafe { &*(ptr.cast::<nak_nir_ipa_flags>()) };
+   f.interp_mode() == ((expected >> 0) & 3)
+   && f.interp_freq() == ((expected >> 2) & 3)
+   && f.interp_loc() == ((expected >> 4) & 3)
+   && f.pad() == ((expected >> 6) & 67108863)
+  },
+  6 => {
+   if std::mem::size_of::<nak_nir_cmat_mul_add_flags>() != 4 { return false; }
+   let f = unsafe { &*(ptr.cast::<nak_nir_cmat_mul_add_flags>()) };
+   f.cmat_type() == ((expected >> 0) & 7)
+   && f.a_type() == ((expected >> 3) & 31)
+   && f.b_type() == ((expected >> 8) & 31)
+   && f.sat() == ((expected >> 13) & 1)
+   && f.pad() == ((expected >> 14) & 262143)
+  },
+  _ => false,
+ }
+}
