+# SPDX-License-Identifier: MIT
+"""Extract NAK's driver-owned constant layout from NVK, without its OS runtime."""
+from pathlib import Path
+import re, sys
+
+private, descriptors, commands, shader, output = map(Path, sys.argv[1:])
+def definition(text, declaration):
+    start = text.index(declaration)
+    brace = text.index('{', start)
+    depth = 0
+    for i in range(brace, len(text)):
+        if text[i] == '{': depth += 1
+        if text[i] == '}':
+            depth -= 1
+            if depth == 0:
+                assert text[i+1] == ';'
+                return text[start:i+2] + '\n'
+    raise ValueError(declaration)
+
+p = private.read_text(encoding='utf-8')
+c = commands.read_text(encoding='utf-8')
+s = shader.read_text(encoding='utf-8')
+parts = ['/* Derived verbatim declarations from NVK; Copyright (c) 2022 Collabora Ltd. and Red Hat Inc.\n'
+         ' * SPDX-License-Identifier: MIT\n'
+         ' * Offline compiler profile only. No NVK runtime or GPU binding is installed. */\n',
+         '#include "nak.h"\n#include <stddef.h>\n']
+for macro in ('NVK_MAX_SETS','NVK_MAX_SAMPLES','NVK_MAX_DYNAMIC_BUFFERS','NVK_MAX_PUSH_SIZE',
+              'NVK_HW_ROOT_TABLE_SIZE','NVK_HW_ROOT_TABLE_FIRST_CB'):
+    m = re.search(r'^#define ' + macro + r'\s+\d+\s*$', p, re.M)
+    assert m, macro
+    parts.append(m.group(0).strip() + '\n')
+parts.append(definition(descriptors.read_text(encoding='utf-8'), 'struct nvk_buffer_address {'))
+parts.append(definition(c, 'struct nvk_root_descriptor_table {'))
+for macro in ('nvk_root_descriptor_offset','nvk_hw_root_table_index','nvk_hw_root_table_offset'):
+    m = re.search(r'^#define ' + macro + r'\(member\)\\\n[^\n]+', c, re.M)
+    assert m, macro
+    parts.append(m.group(0) + '\n')
+for name in ('nak_const_offsets_base','nak_const_offsets_turing_graphics'):
+    parts.append(definition(s, 'const struct nak_constant_offset_info ' + name + ' = {'))
+parts.append('static_assert(sizeof(struct nvk_buffer_address) == 16, "NVK buffer layout");\n')
+output.write_text('\n'.join(parts), encoding='utf-8')
