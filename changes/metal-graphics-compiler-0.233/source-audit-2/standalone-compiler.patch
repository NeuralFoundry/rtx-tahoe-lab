+# SPDX-License-Identifier: MIT
+"""Generate the compiler-only header configuration from the upstream config."""
+from pathlib import Path
+import sys
+
+text = Path(sys.argv[1]).read_text(encoding='utf-8')
+unused = ', "drm-uapi/drm_fourcc.h"'
+assert text.count(unused) == 1
+Path(sys.argv[2]).write_text(text.replace(unused, ''), encoding='utf-8')
